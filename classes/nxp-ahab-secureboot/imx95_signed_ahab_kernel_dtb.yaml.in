# ===========================  ahab Configuration template for mimx9596, Revision: latest.  ============================
# This file is a template — @PLACEHOLDER@ markers are replaced by sed at signing time.
# See nxp-ahab-secureboot.bbclass for the substitution logic.

# ======================================================================================================================
#                                                 == General Options ==
# ======================================================================================================================
family: mimx9596
revision: latest
target_memory: standard
output: @AHAB_KERNEL_SIGNED_BIN@
containers:
  - container:
      srk_set: oem
      used_srk_id: 0
      srk_revoke_mask: 0
      fuse_version: 0
      sw_version: 0
      # Signing key — substituted at build time from AHAB_SIGNER_KEY
      signer: @AHAB_SIGNER_KEY@
      images:
        - kernel: @AHAB_KERNEL_IMAGE@
        - dtb: @AHAB_KERNEL_DTB@
      srk_table:
        srk_array:
          - @AHAB_SRK_KEY_0@
          - @AHAB_SRK_KEY_1@
          - @AHAB_SRK_KEY_2@
          - @AHAB_SRK_KEY_3@
